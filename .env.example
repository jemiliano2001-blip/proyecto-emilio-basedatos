# Copia este archivo a .env.local y llena con los valores reales del
# proyecto de Supabase de Emilio. NUNCA subas .env.local a git.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# La service_role key SOLO se usa del lado del servidor (Edge Functions).
# No debe existir ninguna variable NEXT_PUBLIC_ con la service_role key.
# SUPABASE_SERVICE_ROLE_KEY=  (se configura directo en Supabase, no aquí)
